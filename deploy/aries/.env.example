# Copy to .env and adjust. .env is git-ignored: it holds the agent token.

# Shared secret between the agent and the Studio backend (required). Generate one with:
#   openssl rand -hex 32
ARIES_AGENT_TOKEN=

# Where the agent reaches the Studio backend's gRPC gateway, and where the backend
# scrapes this agent's /metrics.
# ARIES_BACKEND_GRPC_URL=studio.lan:50051
# ARIES_METRICS_URL=http://aries.lan:9464/metrics
# ARIES_AGENT_ID=aries

# Host numeric GIDs for /dev/dri access (the Makefile detects them if unset).
# Check with: getent group render | cut -d: -f3
# RENDER_GID=
# VIDEO_GID=

# Level Zero devices the agent may hand out; executor n is the n-th listed. An integrated
# GPU may enumerate first: confirm indices with `sycl-ls`. Each worker reports the PCI
# address it actually opened, and the agent refuses a mismatch.
# ONEAPI_DEVICE_SELECTOR=level_zero:0,1

# Host directory with qwen-image-2.1/ and qwen-image-2.1-pe-t2i/
# MODELS_DIR=/srv/models

# Published /metrics port
# METRICS_PORT=9464

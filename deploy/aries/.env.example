# Copy to .env and adjust.

# Host numeric GIDs for /dev/dri access (the Makefile detects them if unset).
# Check with: getent group render | cut -d: -f3
# RENDER_GID=
# VIDEO_GID=

# Level Zero devices the manager may use; card n of the manager is the n-th listed.
# An integrated GPU may enumerate first; confirm indices with `sycl-ls` on the host.
# ONEAPI_DEVICE_SELECTOR=level_zero:0,1

# Host directories
# MODELS_DIR=/srv/models            # contains qwen-image-2.1/ and qwen-image-2.1-pe-t2i/
# DATA_DIR=/srv/aries-studio/data   # manager.sqlite and per-job files

# Published HTTP port
# PORT=8000

# Copy to .env and adjust. .env is git-ignored: it holds the agent token.

# Shared secret between Studio and its agents (required; the same value in the agent's
# .env). Generate one with:
#   openssl rand -hex 32
ARIES_AGENT_TOKEN=

# Base URL agents use to download and upload artifacts: this host's HTTP port as the
# GPU host sees it (required).
ARIES_ARTIFACT_BASE_URL=http://studio.lan:8080

# Host directory for the database, images and thumbnails; must be writable by uid 1000:
#   sudo install -d -o 1000 -g 1000 /var/lib/aries-image-studio
# STUDIO_DATA_DIR=/var/lib/aries-image-studio

# Published ports: web app + API, and the agents' gRPC gateway.
# HTTP_PORT=8080
# GRPC_PORT=50051

# RUST_LOG=info

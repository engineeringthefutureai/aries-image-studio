# Copy to .env and adjust. .env is git-ignored: it holds the agent token.

# Shared secret between Studio and its agents (required; the same value in the agent's
# .env). Generate one with:
#   openssl rand -hex 32
ARIES_AGENT_TOKEN=

# Base URL agents use to download and upload artifacts: this host's HTTP port as the
# GPU host sees it (required).
ARIES_ARTIFACT_BASE_URL=http://studio.lan:8080

# Host directory for the database, images and thumbnails; must be writable by uid 1000:
#   sudo install -d -o 1000 -g 1000 /var/lib/aries-image-studio
# STUDIO_DATA_DIR=/var/lib/aries-image-studio

# Published ports: web app + API, and the agents' gRPC gateway.
# HTTP_PORT=8080
# GRPC_PORT=50051

# RUST_LOG=info

# Cloud prompt enhancers (docs/CLOUD_ENHANCERS.md), off by default; the built-in enhancer
# stays the default and the only one that works offline. Switched on, the composer offers
# each provider with a key. The prompt and any reference images then go to that provider,
# and its terms apply (free tiers may use what they receive).
# ARIES_CLOUD_ENHANCERS=on
# ANTHROPIC_API_KEY=            # Claude Sonnet 5.5 (ARIES_ANTHROPIC_MODEL=claude-sonnet-5-5)
# GEMINI_API_KEY=               # Gemini 3.5 Flash-Lite
# Gemini models offered, each model:rpm:tpm (the free tiers' limits; Studio queues
# requests to stay inside them):
# ARIES_GEMINI_MODELS=gemini-3.5-flash-lite:15:250000
# ARIES_GEMINI_THINKING=high    # or minimal: faster, no reasoning

# Sign-in with Google (docs/AUTH.md), off by default: then anyone who can reach Studio can
# use it. With it, only these Google accounts get in, each with its own history; no
# passwords. Needs an OAuth client of type "Web application" whose redirect URI is
# ARIES_PUBLIC_URL/auth/callback (https). Reached on several addresses? List them all,
# comma-separated, and add each one's callback to the same client.
# ARIES_OIDC_CLIENT_ID=
# ARIES_OIDC_CLIENT_SECRET=
# ARIES_AUTH_ALLOWED_EMAILS=you@example.com,partner@example.com
# ARIES_PUBLIC_URL=https://studio.example.com
# ARIES_AUTH_OWNER=                # default: the first allowed address
# Named on /privacy and /terms, the links Google's consent screen asks for:
# ARIES_LEGAL_OPERATOR=Your Name
# ARIES_LEGAL_CONTACT=you@example.com   # or a URL
